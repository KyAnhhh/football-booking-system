classDiagram
    direction LR

    %% Chia namespace theo module để Draw.io bố trí thành các cụm ngang.
    %% Chỉ giữ quan hệ nghiệp vụ/JPA chính; các liên kết audit và ID logic được lược bỏ.

    namespace UserAuth {
        class MembershipTier {
            +Long id
            +String name
        }
        class User {
            +Long id
            +String username
        }
        class ShippingAddress {
            +Long id
            +String addressLine
        }
        class PasswordResetToken {
            +Long id
            +LocalDateTime expiryTime
        }
        class Notification {
            +Long id
            +NotificationType type
        }
    }

    namespace Catalog {
        class Category {
            +Long id
            +String name
        }
        class Brand {
            +Long id
            +String name
        }
        class Product {
            +Long id
            +String name
        }
        class ProductVariant {
            +Long id
            +BigDecimal price
        }
        class ProductImage {
            +Long id
            +String imageUrl
        }
        class Size {
            +Long id
            +String code
        }
        class Review {
            +Long id
            +Integer rating
        }
        class WishList {
            +Long id
            +String status
        }
    }

    namespace Sales {
        class Cart {
            +Long id
            +BigDecimal totalAmount
        }
        class CartItem {
            +Long id
            +Integer totalQuantity
        }
        class Order {
            +Long id
            +OrderStatus orderStatus
        }
        class OrderItem {
            +Long id
            +Integer quantity
        }
        class Payment {
            +Long id
            +PaymentStatus paymentStatus
        }
    }

    namespace BookingField {
        class FootballField {
            +Long id
            +String name
        }
        class FootballFieldImage {
            +Long id
            +String imageUrl
        }
        class Booking {
            +Long id
            +BookingStatus status
        }
        class BookingStatusHistory {
            +Long id
            +BookingStatus newStatus
        }
        class BookingReview {
            +Long id
            +Integer rating
        }
        class ExtraService {
            +Long id
            +String name
        }
        class BookingExtraService {
            +Long id
            +Integer quantity
        }
    }

    namespace PricingMaintenance {
        class FieldPricingRule {
            +Long id
            +BigDecimal pricePerSlot
        }
        class Holiday {
            +Long id
            +LocalDate holidayDate
        }
        class HolidayPricingRule {
            +Long id
            +BigDecimal pricePerSlot
        }
        class Maintenance {
            +Long id
            +LocalDateTime startTime
        }
        class Voucher {
            +Long id
            +String code
        }
        class VoucherUsage {
            +Long id
            +BigDecimal discountAmount
        }
    }

    namespace Inventory {
        class InventoryItem {
            +Long id
            +String itemCode
        }
        class InventoryStock {
            +Long id
            +Integer quantityOnHand
        }
        class InventoryReservation {
            +Long id
            +Integer quantity
        }
        class InventoryTransaction {
            +Long id
            +Integer quantity
        }
        class Supplier {
            +Long id
            +String name
        }
        class StockImport {
            +Long id
            +String importCode
        }
        class StockImportItem {
            +Long id
            +Integer quantity
        }
    }

    %% User/Auth: đặt cạnh các điểm vào của hai luồng chính
    MembershipTier "1" --> "0..*" User
    User "1" *-- "0..1" Cart
    User "1" *-- "0..*" ShippingAddress
    User "1" --> "0..*" PasswordResetToken
    User "1" --> "0..*" Notification

    %% Catalog: chuỗi quan hệ cục bộ, hạn chế nối xuyên module
    Category "1" --> "0..*" Product
    Brand "1" --> "0..*" Product
    Product "1" *-- "0..*" ProductImage
    Product "1" *-- "0..*" ProductVariant
    Size "1" --> "0..*" ProductVariant
    Product "1" --> "0..*" Review
    Product "1" --> "0..*" WishList

    %% Cart / Order / Payment
    Cart "1" *-- "0..*" CartItem
    ProductVariant "1" --> "0..*" CartItem
    User "1" --> "0..*" Order
    ShippingAddress "1" --> "0..*" Order
    Order "1" *-- "0..*" OrderItem
    ProductVariant "1" --> "0..*" OrderItem
    OrderItem "1" --> "0..*" Review
    Order "1" --> "0..1" Payment

    %% Booking / Field
    User "1" --> "0..*" Booking
    FootballField "1" *-- "0..*" FootballFieldImage
    FootballField "1" --> "0..*" Booking
    Booking "1" --> "1" Payment
    Booking "1" *-- "0..*" BookingStatusHistory
    Booking "1" --> "0..1" BookingReview
    Booking "1" *-- "0..*" BookingExtraService
    ExtraService "1" --> "0..*" BookingExtraService

    %% Pricing / Maintenance / Voucher
    FootballField "1" --> "0..*" FieldPricingRule
    FootballField "1" --> "0..*" HolidayPricingRule
    Holiday "1" --> "0..*" HolidayPricingRule
    FootballField "1" --> "0..*" Maintenance
    Voucher "1" --> "0..*" VoucherUsage
    Booking "1" --> "0..*" VoucherUsage

    %% Inventory / Import: cụm độc lập để tránh dây xuyên toàn sơ đồ
    InventoryItem "1" *-- "1" InventoryStock
    InventoryItem "1" --> "0..*" InventoryReservation
    InventoryItem "1" --> "0..*" InventoryTransaction
    Supplier "0..1" --> "0..*" StockImport
    StockImport "1" *-- "0..*" StockImportItem
    InventoryItem "1" --> "0..*" StockImportItem

