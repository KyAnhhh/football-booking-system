flowchart LR
    A([Bắt đầu]) --> B[Chọn sân, ngày và khung giờ]
    B --> C[Kiểm tra slot và lịch bảo trì]
    C --> D{Khả dụng?}
    D -- Không --> E[Chọn khung giờ khác]
    E --> B
    D -- Có --> F[Tính giá theo từng slot]
    F --> G[Áp dụng membership / voucher]
    G --> H[Chọn dịch vụ thêm]
    H --> I{Tồn kho đủ?}
    I -- Không --> H
    I -- Có --> J[Tạo booking PENDING]
    J --> K{Phương thức thanh toán}
    K -- CASH --> L[Admin xác nhận]
    K -- VIETQR --> M[Khách gửi xác nhận thanh toán]
    M --> N[Admin xác nhận payment]
    N --> L
    L --> O[Booking CONFIRMED]
    O --> P[Check-in]
    P --> Q[IN_PROGRESS]
    Q --> R[Check-out]
    R --> S[COMPLETED và hoàn vật tư thuê]
    J --> T{Hủy / hết hạn?}
    T -- Có --> U[CANCELLED<br/>hoàn voucher và tồn giữ chỗ]
    S --> V([Kết thúc])
    U --> V

