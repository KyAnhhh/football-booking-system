@startuml
title Package Diagram - Tổng quan module hệ thống

skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "Frontend React" {
  package "Client Pages" as FE_CLIENT {
    component "Home" as C_HOME
    component "Product" as C_PRODUCT
    component "ProductDetail" as C_PRODUCT_DETAIL
    component "Cart" as C_CART
    component "Checkout" as C_CHECKOUT
    component "FootballField" as C_FIELD
    component "FootballFieldDetail" as C_FIELD_DETAIL
    component "PaymentFootballField" as C_FIELD_PAYMENT
    component "MyBookings" as C_MY_BOOKINGS
    component "BookingDetailPage" as C_BOOKING_DETAIL
    component "MyOrders" as C_MY_ORDERS
    component "Profile" as C_PROFILE
    component "Review" as C_REVIEW
  }

  package "Admin Pages" as FE_ADMIN {
    component "DashboardPage" as A_DASHBOARD
    component "AdminFieldCalendarPage" as A_CALENDAR
    component "BookingPage" as A_BOOKING
    component "AdminBookingDetailPage" as A_BOOKING_DETAIL
    component "FootballFieldPage" as A_FIELD
    component "PricingRulePage" as A_PRICING
    component "HolidayPricingRulePage" as A_HOLIDAY_PRICING
    component "MaintenanceManagementPage" as A_MAINTENANCE
    component "VoucherPage" as A_VOUCHER
    component "ExtraServicePage" as A_EXTRA
    component "HolidayPage" as A_HOLIDAY
    component "ProductPage" as A_PRODUCT
    component "OrderPage" as A_ORDER
    component "PaymentPage" as A_PAYMENT
    component "UserPage" as A_USER
    component "ImportPage" as A_IMPORT
    component "InventoryPage" as A_INVENTORY
  }
}

package "Backend Spring Boot" {
  component "user" as PKG_USER
  component "security" as PKG_SECURITY
  component "field" as PKG_FIELD
  component "booking" as PKG_BOOKING
  component "pricing" as PKG_PRICING
  component "holiday" as PKG_HOLIDAY
  component "maintenance" as PKG_MAINTENANCE
  component "membership" as PKG_MEMBERSHIP
  component "voucher" as PKG_VOUCHER
  component "extra" as PKG_EXTRA
  component "payment" as PKG_PAYMENT
  component "calendar" as PKG_CALENDAR
  component "dashboard" as PKG_DASHBOARD
  component "notification" as PKG_NOTIFICATION
  component "product" as PKG_PRODUCT
  component "order" as PKG_ORDER
  component "review" as PKG_REVIEW
  component "importer" as PKG_IMPORTER
  component "inventory" as PKG_INVENTORY
  component "shared" as PKG_SHARED
}

FE_CLIENT --> PKG_USER : đăng nhập / hồ sơ
FE_CLIENT --> PKG_PRODUCT : xem sản phẩm
FE_CLIENT --> PKG_ORDER : giỏ hàng / đặt hàng
FE_CLIENT --> PKG_FIELD : xem sân / slot / gợi ý sân
FE_CLIENT --> PKG_BOOKING : đặt sân / hủy / chi tiết
FE_CLIENT --> PKG_PAYMENT : thanh toán
FE_CLIENT --> PKG_REVIEW : đánh giá
FE_CLIENT --> PKG_NOTIFICATION : thông báo

FE_ADMIN --> PKG_DASHBOARD
FE_ADMIN --> PKG_CALENDAR
FE_ADMIN --> PKG_BOOKING
FE_ADMIN --> PKG_FIELD
FE_ADMIN --> PKG_PRICING
FE_ADMIN --> PKG_HOLIDAY
FE_ADMIN --> PKG_MAINTENANCE
FE_ADMIN --> PKG_VOUCHER
FE_ADMIN --> PKG_EXTRA
FE_ADMIN --> PKG_PRODUCT
FE_ADMIN --> PKG_ORDER
FE_ADMIN --> PKG_PAYMENT
FE_ADMIN --> PKG_USER
FE_ADMIN --> PKG_IMPORTER
FE_ADMIN --> PKG_INVENTORY

PKG_SECURITY --> PKG_USER : JWT + Role
PKG_BOOKING --> PKG_FIELD
PKG_BOOKING --> PKG_PRICING
PKG_BOOKING --> PKG_MAINTENANCE
PKG_BOOKING --> PKG_MEMBERSHIP
PKG_BOOKING --> PKG_VOUCHER
PKG_BOOKING --> PKG_EXTRA
PKG_BOOKING --> PKG_INVENTORY : extra stock
PKG_BOOKING --> PKG_PAYMENT
PKG_BOOKING --> PKG_NOTIFICATION
PKG_BOOKING --> PKG_REVIEW
PKG_PRICING --> PKG_HOLIDAY
PKG_PRICING --> PKG_FIELD
PKG_CALENDAR --> PKG_BOOKING
PKG_CALENDAR --> PKG_FIELD
PKG_ORDER --> PKG_PRODUCT
PKG_ORDER --> PKG_INVENTORY : product stock
PKG_ORDER --> PKG_PAYMENT
PKG_ORDER --> PKG_USER
PKG_REVIEW --> PKG_PRODUCT
PKG_REVIEW --> PKG_BOOKING
PKG_NOTIFICATION --> PKG_USER
PKG_IMPORTER --> PKG_PRODUCT
PKG_IMPORTER --> PKG_FIELD
PKG_IMPORTER --> PKG_PRICING
PKG_IMPORTER --> PKG_HOLIDAY
PKG_IMPORTER --> PKG_EXTRA
PKG_PRODUCT --> PKG_INVENTORY : linked variant
PKG_EXTRA --> PKG_INVENTORY : linked service

note right of PKG_SECURITY
  Role hiện có trong source:
  ROLE_ADMIN, ROLE_MANAGER,
  ROLE_STAFF, ROLE_CLIENT.

  Admin quản lý toàn bộ user.
  Manager chỉ quản lý Staff và Client.
  Staff không quản lý user.
  Client chỉ quản lý hồ sơ cá nhân.
end note

@enduml
