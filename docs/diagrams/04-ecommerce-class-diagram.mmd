classDiagram
    direction LR

    class Product {
        +Long id
        +String name
        +BigDecimal price
        +PublicationStatus publicationStatus
    }
    class ProductVariant {
        +Long id
        +String sku
        +Integer stockQuantity
        +BigDecimal price
    }
    class Category {
        +Long id
        +String name
    }
    class Brand {
        +Long id
        +String name
    }
    class Size {
        +Long id
        +String code
        +String name
    }
    class ProductImage {
        +Long id
        +String imageUrl
        +Boolean isPrimary
    }
    class Cart {
        +Long id
        +BigDecimal totalAmount
    }
    class CartItem {
        +Long id
        +Integer totalQuantity
        +BigDecimal priceAtAddedTime
    }
    class Review {
        +Long id
        +Integer rating
        +String comment
    }

    Category "1" --> "0..*" Product
    Brand "1" --> "0..*" Product
    Product "1" *-- "0..*" ProductVariant
    Product "1" *-- "0..*" ProductImage
    Size "1" --> "0..*" ProductVariant
    Cart "1" *-- "0..*" CartItem
    ProductVariant "1" --> "0..*" CartItem
    Size "1" --> "0..*" CartItem
    Product "1" --> "0..*" Review

