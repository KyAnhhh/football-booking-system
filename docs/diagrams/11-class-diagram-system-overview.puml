@startuml
title Class Diagram Tổng Thể - Football Booking System

left to right direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide methods

package "Tài khoản và thành viên" #EAF2F8 {
  class User {
    Long id
    String username
    String email
    String phone
    Role role
    String status
    Integer loyaltyPoints
  }

  class MembershipTier {
    Long id
    String name
    Integer minPoints
    BigDecimal discountPercentage
  }

  class ShippingAddress {
    Long id
    String fullName
    String phone
    String address
    String addressLine
    String ward
    String district
    String city
  }

  class PasswordResetToken {
    Long id
    String token
    LocalDateTime expiryTime
  }

  class Notification {
    Long id
    NotificationType type
    String title
    String referenceType
    Long referenceId
    Boolean isRead
  }
}

package "Sân bóng và bảng giá" #E8F5E9 {
  class FootballField {
    Long id
    String fieldName
    String address
    FieldType fieldType
    FieldStatus status
    BigDecimal pricePerHour
  }

  class FootballFieldImage {
    Long id
    String imageUrl
    Boolean isPrimary
    Integer sortOrder
  }

  class Maintenance {
    Long id
    Long fieldId
    LocalDateTime startTime
    LocalDateTime endTime
    String reason
  }

  class FieldPricingRule {
    Long id
    DayOfWeek dayOfWeek
    LocalTime startTime
    LocalTime endTime
    BigDecimal pricePerSlot
    Integer slotDuration
    Boolean isActive
  }

  class Holiday {
    Long id
    String name
    LocalDate holidayDate
    Boolean isActive
  }

  class HolidayPricingRule {
    Long id
    LocalTime startTime
    LocalTime endTime
    BigDecimal pricePerSlot
    Integer slotDuration
    Boolean isActive
  }
}

package "Đặt sân" #FFF3E0 {
  class Booking {
    Long id
    LocalDateTime startTime
    LocalDateTime endTime
    BigDecimal originalPrice
    BigDecimal extraServicePrice
    BigDecimal membershipDiscount
    BigDecimal voucherDiscount
    BigDecimal totalPrice
    BookingStatus status
  }

  class Payment {
    Long id
    PaymentType paymentType
    PaymentStatus paymentStatus
    PaymentMethod paymentMethod
    BigDecimal totalAmount
  }

  class ExtraService {
    Long id
    String name
    BigDecimal price
    Boolean trackStock
    Integer remainingQuantity
    Long inventoryItemId
  }

  class BookingExtraService {
    Long id
    Integer quantity
    BigDecimal unitPrice
    BigDecimal totalPrice
    Boolean stockReserved
    Boolean stockDeducted
    Boolean stockReturned
    Long inventoryReservationId
  }

  class Voucher {
    Long id
    String code
    DiscountType discountType
    BigDecimal discountValue
    Integer quantity
    Boolean isActive
  }

  class VoucherUsage {
    Long id
    String voucherCode
    BigDecimal discountAmount
    Boolean isRefunded
    LocalDateTime usedAt
  }

  class BookingStatusHistory {
    Long id
    BookingStatus oldStatus
    BookingStatus newStatus
    String changedByRole
    LocalDateTime createdAt
  }

  class BookingReview {
    Long id
    Integer rating
    String comment
  }
}

package "Thương mại điện tử" #F3E5F5 {
  class Product {
    Long id
    String name
    String description
    Integer discount
  }

  class Brand {
    Long id
    String name
  }

  class Category {
    Long id
    String name
  }

  class ProductVariant {
    Long id
    BigDecimal price
    Integer stock
    Integer soldQuantity
    Long inventoryItemId
  }

  class Size {
    Long id
    String name
    String code
  }

  class ProductImage {
    Long id
    String imageUrl
    Boolean isPrimary
  }

  class Cart {
    Long id
    BigDecimal totalAmount
  }

  class CartItem {
    Long id
    Integer totalQuantity
    BigDecimal priceAtAddedTime
  }

  class Order {
    Long id
    OrderStatus orderStatus
    BigDecimal totalAmount
    BigDecimal shippingCost
    LocalDateTime orderDate
  }

  class OrderItem {
    Long id
    String productName
    Integer quantity
    BigDecimal finalPrice
    BigDecimal total
    Boolean stockReserved
    Boolean stockDeducted
    Boolean stockReturned
    Long inventoryReservationId
  }

  class Review {
    Long id
    Integer rating
    String comment
  }

  class WishList {
    Long id
    String status
  }
}

package "Quản lý kho" #E0F2F1 {
  class InventoryItem {
    Long id
    String itemCode
    String name
    InventoryItemType itemType
    Long referenceId
    String unit
  }

  class InventoryStock {
    Long id
    Integer quantityOnHand
    Integer reservedQuantity
    Integer availableQuantity
  }

  class InventoryReservation {
    Long id
    InventoryReferenceType referenceType
    Long referenceId
    Long referenceLineId
    Integer quantity
    InventoryReservationStatus status
  }

  class InventoryTransaction {
    Long id
    InventoryTransactionType transactionType
    Integer quantity
    Integer beforeQuantity
    Integer afterQuantity
    Integer beforeReservedQuantity
    Integer afterReservedQuantity
  }

  class Supplier {
    Long id
    String name
    String phone
    String email
  }

  class StockImport {
    Long id
    String importCode
    BigDecimal totalAmount
    LocalDateTime createdAt
  }

  class StockImportItem {
    Long id
    Integer quantity
    BigDecimal unitCost
    BigDecimal totalCost
  }
}

' Quan hệ tài khoản
MembershipTier "1" -- "0..*" User : hạng thành viên
User "1" -- "0..*" ShippingAddress : địa chỉ
User "1" -- "0..*" PasswordResetToken : reset mật khẩu
User "1" -- "0..*" Notification : nhận thông báo

' Quan hệ sân và pricing
FootballField "1" *-- "0..*" FootballFieldImage : hình ảnh
FootballField "1" -- "0..*" Maintenance : bảo trì
FootballField "1" -- "0..*" FieldPricingRule : giá theo thứ
FootballField "1" -- "0..*" HolidayPricingRule : giá ngày lễ
Holiday "1" -- "0..*" HolidayPricingRule : cấu hình giá

' Quan hệ booking
User "1" -- "0..*" Booking : tạo booking
FootballField "1" -- "0..*" Booking : được đặt
Booking "1" -- "1" Payment : thanh toán
Booking "1" *-- "0..*" BookingExtraService : dịch vụ đã chọn
ExtraService "1" -- "0..*" BookingExtraService : dịch vụ
Booking "1" -- "0..*" BookingStatusHistory : lịch sử trạng thái
User "0..1" -- "0..*" BookingStatusHistory : người thay đổi
Booking "1" -- "0..1" BookingReview : đánh giá sân
User "1" -- "0..*" BookingReview : người đánh giá
Voucher "1" -- "0..*" VoucherUsage : lịch sử sử dụng
Booking "1" -- "0..1" VoucherUsage : voucher áp dụng
User "1" -- "0..*" VoucherUsage : người sử dụng

' Quan hệ ecommerce
Category "1" -- "0..*" Product : danh mục
Brand "0..1" -- "0..*" Product : thương hiệu
Product "1" *-- "0..*" ProductVariant : biến thể
Product "1" *-- "0..*" ProductImage : hình ảnh
Size "1" -- "0..*" ProductVariant : kích cỡ
User "1" -- "0..1" Cart : giỏ hàng
Cart "1" *-- "0..*" CartItem : dòng giỏ hàng
ProductVariant "1" -- "0..*" CartItem : biến thể
User "1" -- "0..*" Order : đặt hàng
ShippingAddress "1" -- "0..*" Order : địa chỉ giao
Order "1" *-- "1..*" OrderItem : chi tiết
ProductVariant "1" -- "0..*" OrderItem : biến thể
Order "1" -- "0..1" Payment : thanh toán
User "1" -- "0..*" Review : viết review
Product "1" -- "0..*" Review : được review
OrderItem "1" -- "0..*" Review : xác thực đã mua
User "1" -- "0..*" WishList : danh sách yêu thích
Product "1" -- "0..*" WishList : sản phẩm yêu thích

' Quan hệ kho
InventoryItem "1" -- "1" InventoryStock : tồn hiện tại
InventoryItem "1" -- "0..*" InventoryReservation : giữ kho
InventoryItem "1" -- "0..*" InventoryTransaction : lịch sử biến động
Supplier "0..1" -- "0..*" StockImport : cung cấp
StockImport "1" *-- "1..*" StockImportItem : chi tiết nhập
InventoryItem "1" -- "0..*" StockImportItem : item nhập
User "0..1" -- "0..*" StockImport : người tạo
User "0..1" -- "0..*" InventoryTransaction : người thực hiện

' Liên kết ID mềm giữa kho và nghiệp vụ
ProductVariant "0..*" ..> "0..1" InventoryItem : inventoryItemId
ExtraService "0..*" ..> "0..1" InventoryItem : inventoryItemId
OrderItem "0..*" ..> "0..1" InventoryReservation : inventoryReservationId
BookingExtraService "0..*" ..> "0..1" InventoryReservation : inventoryReservationId

legend bottom
  |= Ký hiệu |= Ý nghĩa |
  | -- | Quan hệ JPA |
  | *-- | Quan hệ thành phần / cascade |
  | ..> | Liên kết nghiệp vụ bằng trường ID, không phải quan hệ JPA |

  Sơ đồ tổng thể chỉ hiển thị field nghiệp vụ quan trọng.
  Chi tiết từng miền nằm trong diagram 03, 04, 05 và 10.
endlegend

@enduml
