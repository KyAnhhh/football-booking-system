    PV -->|"1 : N"| CI
    U -->|"1 : N"| ORD
    SA -->|"1 : N"| ORD
    ORD -->|"1 : N"| OI
    PV -->|"1 : N"| OI
    ORD -->|"1 : 0..1"| PAY
    U -->|"1 : N"| REV
    PR -->|"1 : N"| REV
    OI -->|"1 : N"| REV
    U -->|"1 : N"| WL
    PR -->|"1 : N"| WL
    U -->|"1 : N"| BK
    FF -->|"1 : N"| BK
    PAY -->|"1 : 0..1"| BK
    FF -->|"1 : N"| FFI
    BK -->|"1 : N"| BES
    ES -->|"1 : N"| BES
    BK -->|"1 : N"| BSH
    U -->|"1 : N"| BSH
    BK -->|"1 : 0..1"| BREV
    U -->|"1 : N"| BREV
    FF -->|"1 : N"| FPR
    FF -->|"1 : N"| HPR
