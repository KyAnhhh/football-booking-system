@startuml
title Sequence Diagram - Xác nhận booking

skinparam shadowing false
autonumber

actor "Admin / Manager / Staff\nNhóm vận hành" as OPERATOR
boundary "AdminBookingController" as CTRL
control "BookingServiceImpl" as BOOKING_SERVICE
database "BookingRepository" as BOOKING_REPO
entity "Booking" as BOOKING
entity "Payment" as PAYMENT
control "MembershipService" as MEMBERSHIP_SERVICE
control "NotificationService" as NOTIFICATION_SERVICE
control "BookingStatusHistoryService" as HISTORY_SERVICE
control "InventoryService" as INVENTORY_SERVICE

OPERATOR -> CTRL : PATCH /api/admin/bookings/{id}/confirm
CTRL -> BOOKING_SERVICE : confirmBooking(bookingId)

BOOKING_SERVICE -> BOOKING_REPO : findByIdForUpdate(bookingId)
BOOKING_REPO --> BOOKING_SERVICE : Booking

BOOKING_SERVICE -> BOOKING : getStatus()

alt Status khác PENDING
  BOOKING_SERVICE --> CTRL : IllegalStateException\nBooking already processed
  CTRL --> OPERATOR : Trả lỗi
else Status là PENDING
  BOOKING_SERVICE -> BOOKING : getPayment()

  alt Payment không tồn tại
    BOOKING_SERVICE --> CTRL : RuntimeException\nPayment not found
    CTRL --> OPERATOR : Trả lỗi
  else Payment tồn tại
    BOOKING_SERVICE -> INVENTORY_SERVICE : commitReservation cho từng booking extra
    INVENTORY_SERVICE --> BOOKING_SERVICE : COMMITTED
    BOOKING_SERVICE -> PAYMENT : setPaymentStatus(PAID)
    BOOKING_SERVICE -> PAYMENT : setPaymentDate(now)
    BOOKING_SERVICE -> MEMBERSHIP_SERVICE : addPoints(userId, totalPrice)
    BOOKING_SERVICE -> BOOKING : setStatus(CONFIRMED)
    BOOKING_SERVICE -> BOOKING_REPO : save(booking)
    BOOKING_REPO --> BOOKING_SERVICE : updatedBooking
    BOOKING_SERVICE -> NOTIFICATION_SERVICE : notifyUserBookingStatusChanged(updatedBooking, previousStatus)
    BOOKING_SERVICE -> HISTORY_SERVICE : record PENDING sang CONFIRMED
    BOOKING_SERVICE --> CTRL : void
    CTRL --> OPERATOR : ApiResponse void
  end
end

legend bottom
  Theo SecurityConfiguration và AdminRoutes hiện tại,
  Admin, Manager và Staff đều có thể vào module booking vận hành.

  Quyền quản lý user không nằm trong flow này:
  Admin quản lý toàn bộ user.
  Manager chỉ quản lý Staff và Client.
  Staff không quản lý user.

  Source còn có updateBookingStatus(...).
  Khi newStatus = CONFIRMED, method này cũng gọi confirmPendingBooking().
  Vì vậy payment và membership point dùng chung logic xác nhận.
endlegend

@enduml
