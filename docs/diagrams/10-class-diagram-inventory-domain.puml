@startuml
title Class Diagram - Miền quản lý kho

skinparam classAttributeIconSize 0
skinparam shadowing false
hide methods

class InventoryItem {
  Long id
  String itemCode
  String name
  InventoryItemType itemType
  Long referenceId
  String unit
  Boolean active
  Integer lowStockThreshold
  LocalDateTime createdAt
  LocalDateTime updatedAt
}

class InventoryStock {
  Long id
  Integer quantityOnHand
  Integer reservedQuantity
  Integer availableQuantity
  LocalDateTime updatedAt
}

class InventoryTransaction {
  Long id
  InventoryTransactionType transactionType
  Integer quantity
  Integer beforeQuantity
  Integer afterQuantity
  InventoryReferenceType referenceType
  Long referenceId
  String note
  LocalDateTime createdAt
}

class InventoryReservation {
  Long id
  InventoryReferenceType referenceType
  Long referenceId
  Long referenceLineId
  Integer quantity
  InventoryReservationStatus status
  LocalDateTime reservedAt
  LocalDateTime expiresAt
  LocalDateTime committedAt
  LocalDateTime releasedAt
}

class Supplier {
  Long id
  String name
  String phone
  String email
  String address
  Boolean active
  LocalDateTime createdAt
  LocalDateTime updatedAt
}

class StockImport {
  Long id
  String importCode
  BigDecimal totalAmount
  String note
  LocalDateTime createdAt
}

class StockImportItem {
  Long id
  Integer quantity
  BigDecimal unitCost
  BigDecimal totalCost
}

class User {
  Long id
  String username
  Role role
}

class ProductVariant {
  Long id
  Integer stock
  Long inventoryItemId
}

class ExtraService {
  Long id
  Boolean trackStock
  Integer remainingQuantity
  Long inventoryItemId
}

class OrderItem {
  Long id
  Boolean stockDeducted
  Boolean stockReserved
  Boolean stockReturned
  Long inventoryReservationId
}

class BookingExtraService {
  Long id
  Boolean stockDeducted
  Boolean stockReserved
  Boolean stockReturned
  Long inventoryReservationId
  Long inventoryTransactionId
}

enum InventoryItemType {
  PRODUCT_VARIANT
  EXTRA_SERVICE
  FIELD_ASSET
  CONSUMABLE
  OTHER
}

enum InventoryTransactionType {
  IMPORT
  EXPORT
  SALE
  BOOKING_EXTRA
  RETURN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  DAMAGED
  LOST
}

enum InventoryReferenceType {
  ORDER
  BOOKING
  EXTRA_SERVICE
  PRODUCT_VARIANT
  STOCK_IMPORT
  MANUAL_ADJUSTMENT
  MAINTENANCE
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

InventoryItem "1" -- "1" InventoryStock : tồn hiện tại
InventoryItem "1" -- "0..*" InventoryTransaction : phát sinh giao dịch
InventoryItem "1" -- "0..*" InventoryReservation : giữ tồn
Supplier "0..1" -- "0..*" StockImport : cung cấp
StockImport "1" *-- "1..*" StockImportItem : chi tiết nhập
InventoryItem "1" -- "0..*" StockImportItem : item được nhập
User "0..1" -- "0..*" StockImport : người tạo
User "0..1" -- "0..*" InventoryTransaction : người thực hiện

ProductVariant "0..*" ..> "0..1" InventoryItem : inventoryItemId
ExtraService "0..*" ..> "0..1" InventoryItem : inventoryItemId
OrderItem ..> InventoryTransaction : SALE / RETURN qua orderId
OrderItem "0..*" ..> "0..1" InventoryReservation : inventoryReservationId
BookingExtraService "0..*" ..> "0..1" InventoryTransaction : inventoryTransactionId
BookingExtraService "0..*" ..> "0..1" InventoryReservation : inventoryReservationId

InventoryItem --> InventoryItemType
InventoryTransaction --> InventoryTransactionType
InventoryTransaction --> InventoryReferenceType
InventoryReservation --> InventoryReservationStatus

note right of InventoryStock
  InventoryService khóa dòng tồn kho bằng PESSIMISTIC_WRITE
  trước khi thay đổi quantityOnHand.
  availableQuantity = quantityOnHand - reservedQuantity.
end note

note bottom of ProductVariant
  ProductVariant và ExtraService chỉ lưu inventoryItemId,
  không khai báo quan hệ JPA tới InventoryItem.
  stock và remainingQuantity hiện được đồng bộ làm dữ liệu tương thích.

  ProductVariant cũ được đồng bộ bằng itemCode PV-{variantId}.
  Mỗi variant được xử lý trong transaction riêng và có thể chạy lại an toàn.
end note

note bottom of InventoryTransaction
  referenceType + referenceId liên kết nghiệp vụ mềm
  tới ORDER, BOOKING, STOCK_IMPORT hoặc điều chỉnh thủ công.
  Đây không phải khóa ngoại JPA.
end note

@enduml
