classDiagram
    direction LR

    class User {
        +Long id
        +String username
    }
    class ShippingAddress {
        +Long id
        +String fullName
        +String phone
        +String addressLine
    }
    class Order {
        +Long id
        +BigDecimal totalAmount
        +OrderStatus orderStatus
        +PaymentMethod paymentMethod
        +BigDecimal shippingCost
    }
    class OrderItem {
        +Long id
        +String productName
        +Integer quantity
        +BigDecimal finalPrice
        +BigDecimal total
    }
    class ProductVariant {
        +Long id
        +String sku
    }
    class Payment {
        +Long id
        +PaymentType paymentType
        +PaymentStatus paymentStatus
        +PaymentMethod paymentMethod
        +BigDecimal totalAmount
        +String transactionCode
    }
    class OrderService {
        <<interface>>
        +checkout(userId, request)
        +updateOrderStatus(orderId, status)
        +cancelOrder(orderId, userId)
    }
    class PaymentService {
        <<interface>>
        +confirmPayment(orderId)
        +confirmBookingPayment(bookingId)
    }

    User "1" --> "0..*" ShippingAddress
    User "1" --> "0..*" Order
    ShippingAddress "1" --> "0..*" Order
    Order "1" *-- "1..*" OrderItem
    ProductVariant "1" --> "0..*" OrderItem
    Order "1" --> "0..1" Payment
    OrderService ..> Payment
    PaymentService ..> Order

