sequenceDiagram
    autonumber
    actor Admin
    participant C as AdminBookingController
    participant S as BookingService
    participant B as BookingRepository
    participant Pay as PaymentService
    participant I as InventoryService
    participant H as StatusHistoryService
    participant M as MembershipService
    participant N as NotificationService

    Admin->>C: PATCH /api/admin/bookings/{id}/confirm
    C->>S: confirmBooking(bookingId)
    S->>B: findByIdForUpdate()
    alt Booking không ở trạng thái PENDING
        S-->>C: lỗi trạng thái
    else VietQR chưa được thanh toán
        S-->>C: lỗi payment chưa PAID
    else Có thể xác nhận
        opt Payment VietQR đang chờ
            S->>Pay: confirmBookingPayment(bookingId)
            Pay-->>S: payment PAID
        end
        S->>I: commit extra-service reservations
        S->>B: save status CONFIRMED
        S->>H: record PENDING → CONFIRMED
        S->>M: add loyalty points
        S->>N: notifyUserBookingStatusChanged()
        S-->>C: hoàn tất
        C-->>Admin: 200 OK
    end

