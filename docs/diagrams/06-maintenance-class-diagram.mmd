classDiagram
    direction LR

    class FootballField {
        +Long id
        +String name
        +FieldStatus status
    }
    class Maintenance {
        +Long id
        +Long fieldId
        +LocalDateTime startTime
        +LocalDateTime endTime
        +String reason
        +String description
    }
    class MaintenanceRequest {
        +Long fieldId
        +LocalDateTime startTime
        +LocalDateTime endTime
        +String reason
    }
    class MaintenanceResponse {
        +Long id
        +String fieldName
        +LocalDateTime startTime
        +LocalDateTime endTime
    }
    class MaintenanceService {
        <<interface>>
        +createMaintenance(request)
        +updateMaintenance(id, request)
        +deleteMaintenance(id)
        +getMaintenanceSchedule(fieldId, from, to)
    }
    class MaintenanceRepository {
        <<repository>>
        +findOverlappingMaintenance()
    }
    class MaintenanceTimePolicy {
        +validateTimeRange(start, end)
        +isOverlapping(start1, end1, start2, end2)
    }

    FootballField "1" --> "0..*" Maintenance
    MaintenanceService ..> MaintenanceRequest
    MaintenanceService ..> MaintenanceResponse
    MaintenanceService ..> MaintenanceRepository
    MaintenanceService ..> MaintenanceTimePolicy

