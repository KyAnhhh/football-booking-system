@startuml
title Sequence Diagram - Tạo booking

skinparam shadowing false
autonumber

actor "Khách hàng" as CLIENT
boundary "UserBookingController" as CTRL
control "BookingServiceImpl" as BOOKING_SERVICE
database "UserRepository" as USER_REPO
database "FootballFieldRepository" as FIELD_REPO
control "MaintenanceService" as MAINTENANCE_SERVICE
database "BookingRepository" as BOOKING_REPO
control "PricingService" as PRICING_SERVICE
database "ExtraServiceRepository" as EXTRA_REPO
control "MembershipService" as MEMBERSHIP_SERVICE
control "VoucherService" as VOUCHER_SERVICE
database "BookingExtraServiceRepository" as BOOKING_EXTRA_REPO
control "InventoryService" as INVENTORY_SERVICE
database "InventoryStockRepository" as INVENTORY_STOCK_REPO
database "InventoryTransactionRepository" as INVENTORY_TX_REPO
database "InventoryReservationRepository" as INVENTORY_RESERVATION_REPO
control "NotificationService" as NOTIFICATION_SERVICE
control "BookingStatusHistoryService" as HISTORY_SERVICE
entity "Payment" as PAYMENT

CLIENT -> CTRL : POST /api/user/bookings\nBookingRequest
CTRL -> BOOKING_SERVICE : createBooking(request, userId)

BOOKING_SERVICE -> BOOKING_SERVICE : Validate request\nfieldId, time, future time
BOOKING_SERVICE -> USER_REPO : findById(userId)
USER_REPO --> BOOKING_SERVICE : User

BOOKING_SERVICE -> FIELD_REPO : findByIdForUpdate(fieldId)
FIELD_REPO --> BOOKING_SERVICE : FootballField

BOOKING_SERVICE -> BOOKING_SERVICE : Kiểm tra FieldStatus.AVAILABLE
BOOKING_SERVICE -> MAINTENANCE_SERVICE : isFieldAvailable(fieldId, start, end)
MAINTENANCE_SERVICE --> BOOKING_SERVICE : true hoặc false

alt Sân đang bảo trì
  BOOKING_SERVICE --> CTRL : RuntimeException
  CTRL --> CLIENT : Trả lỗi
else Sân khả dụng
  BOOKING_SERVICE -> BOOKING_REPO : findConflictsForUpdate(fieldId, start, end)
  BOOKING_REPO --> BOOKING_SERVICE : Danh sách conflict

  alt Đã có booking trùng giờ
    BOOKING_SERVICE --> CTRL : IllegalStateException
    CTRL --> CLIENT : Trả lỗi
  else Không trùng giờ
    BOOKING_SERVICE -> PRICING_SERVICE : calculatePrice(fieldId, start, end)
    PRICING_SERVICE --> BOOKING_SERVICE : fieldPrice

    loop Từng dịch vụ thêm
      BOOKING_SERVICE -> EXTRA_REPO : findByIdForUpdate(serviceId)
      EXTRA_REPO --> BOOKING_SERVICE : ExtraService
      BOOKING_SERVICE -> BOOKING_SERVICE : Validate active và quantity
      opt trackStock=true và có inventoryItemId
        BOOKING_SERVICE -> INVENTORY_SERVICE : getStockByItemId(inventoryItemId)
        INVENTORY_SERVICE --> BOOKING_SERVICE : availableQuantity
      else Chưa liên kết Inventory
        BOOKING_SERVICE -> BOOKING_SERVICE : kiểm tra remainingQuantity
      end
    end

    BOOKING_SERVICE -> BOOKING_SERVICE : originalPrice = fieldPrice + extraServicePrice
    BOOKING_SERVICE -> MEMBERSHIP_SERVICE : applyMembershipDiscount(userId, originalPrice)
    MEMBERSHIP_SERVICE --> BOOKING_SERVICE : priceAfterMembership

    opt Có voucherCode
      BOOKING_SERVICE -> VOUCHER_SERVICE : consumeVoucher(code, priceAfterMembership)
      VOUCHER_SERVICE --> BOOKING_SERVICE : VoucherApplicationResult
    end

    BOOKING_SERVICE -> PAYMENT : Tạo Payment UNPAID\ntotalAmount = finalPrice
    BOOKING_SERVICE -> BOOKING_REPO : save Booking PENDING kèm Payment
    BOOKING_REPO --> BOOKING_SERVICE : savedBooking

    opt Có voucher đã consume
      BOOKING_SERVICE -> VOUCHER_SERVICE : recordUsage(result, userId, bookingId)
    end

    loop Từng dịch vụ thêm đã chọn
      opt trackStock=true và có inventoryItemId
        BOOKING_SERVICE -> INVENTORY_SERVICE : reserveStock(itemId, quantity, BOOKING,\nbookingId, bookingExtraId, userId)
        INVENTORY_SERVICE -> INVENTORY_STOCK_REPO : findByInventoryItemIdForUpdate(itemId)
        INVENTORY_STOCK_REPO --> INVENTORY_SERVICE : InventoryStock đã khóa
        INVENTORY_SERVICE -> INVENTORY_STOCK_REPO : save(reservedQuantity + quantity)
        INVENTORY_SERVICE -> INVENTORY_RESERVATION_REPO : save ACTIVE reservation
        INVENTORY_SERVICE -> INVENTORY_TX_REPO : save RESERVE transaction
        INVENTORY_TX_REPO --> INVENTORY_SERVICE : InventoryTransaction
        INVENTORY_SERVICE --> BOOKING_SERVICE : reservationId + availableQuantity
      else Chưa liên kết Inventory
        BOOKING_SERVICE -> BOOKING_SERVICE : trừ remainingQuantity trực tiếp
      end
      BOOKING_SERVICE -> BOOKING_EXTRA_REPO : save BookingExtraService
    end

    BOOKING_SERVICE -> NOTIFICATION_SERVICE : notifyAdminsBookingCreated(savedBooking)
    BOOKING_SERVICE -> HISTORY_SERVICE : record trạng thái PENDING
    BOOKING_SERVICE --> CTRL : BookingResponse
    CTRL --> CLIENT : ApiResponse BookingResponse
  end
end

legend bottom
  Booking PENDING chỉ giữ kho bằng reservedQuantity.
  CONFIRMED mới commit và trừ quantityOnHand.
  CANCELLED hoặc EXPIRED sẽ release reservation chưa commit.
endlegend

@enduml
