classDiagram
  direction LR

  class User {
    +id
    +tenDangNhap
    +email
    +soDienThoai
    +vaiTro
    +diemThanhVien
  }

  class MembershipTier {
    +id
    +tenHang
    +diemYeuCau
    +phanTramGiam
  }

  class FootballField {
    +id
    +tenSan
    +loaiSan
    +giaCoBan
    +trangThai
  }

  class Booking {
    +id
    +thoiGianBatDau
    +thoiGianKetThuc
    +tongTien
    +trangThai
  }

  class Payment {
    +id
    +loaiThanhToan
    +phuongThuc
    +trangThai
    +tongTien
  }

  class Product {
    +id
    +tenSanPham
    +trangThaiXuatBan
  }

  class ProductVariant {
    +id
    +giaBan
    +tonKho
  }

  class Order {
    +id
    +tongTien
    +trangThai
  }

  class OrderItem {
    +id
    +tenSanPhamSnapshot
    +giaSnapshot
    +soLuong
  }

  class InventoryItem {
    +id
    +maHang
    +tenHang
    +loaiHang
  }

  class InventoryStock {
    +id
    +tonThucTe
    +tonGiuCho
    +tonKhaDung
  }

  class Voucher {
    +id
    +maVoucher
    +loaiGiamGia
    +giaTriGiam
  }

  class Notification {
    +id
    +tieuDe
    +noiDung
    +daDoc
  }

  User "n" --> "1" MembershipTier : thuộc hạng
  User "1" --> "n" Booking : tạo đặt sân
  FootballField "1" --> "n" Booking : được đặt
  Booking "1" --> "1" Payment : thanh toán
  User "1" --> "n" Order : tạo đơn hàng
  Order "1" --> "n" OrderItem : gồm
  Order "1" --> "1" Payment : thanh toán
  Product "1" --> "n" ProductVariant : có biến thể
  ProductVariant "0..1" --> "1" InventoryItem : liên kết kho
  InventoryItem "1" --> "1" InventoryStock : có tồn kho
  Voucher "1" --> "n" Booking : áp dụng
  User "1" --> "n" Notification : nhận thông báo
