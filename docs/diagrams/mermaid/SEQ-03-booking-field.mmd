sequenceDiagram
  autonumber
  actor Client
  participant FE as React Booking Page
  participant Controller as UserBookingController
  participant BookingService as BookingServiceImpl
  participant Pricing as PricingService
  participant Membership as MembershipService
  participant Voucher as VoucherService
  participant Inventory as InventoryService
  participant DB as MySQL
  participant Payment as Payment Entity

  Client->>FE: Select field, slot, extra services, voucher
  FE->>Controller: POST /api/user/bookings
  Controller->>BookingService: createBooking(request, userId)
  BookingService->>DB: Load user and football field
  BookingService->>BookingService: Validate time range and availability
  BookingService->>Pricing: calculatePrice(fieldId, start, end)
  Pricing-->>BookingService: Field price
  BookingService->>DB: Load selected extra services

  loop Each selected extra service
    BookingService->>Inventory: reserveStock(extraItemId, qty, BOOKING)
    Inventory->>DB: Reserve stock if tracked
  end

  BookingService->>Membership: applyMembershipDiscount(userId, originalPrice)
  Membership-->>BookingService: Price after membership

  alt Voucher code exists
    BookingService->>Voucher: consumeVoucher(code, amount)
    Voucher-->>BookingService: Final amount and discount
  end

  BookingService->>Payment: Create booking payment status UNPAID
  BookingService->>DB: Save Booking, Payment, BookingExtraService
  BookingService->>Voucher: recordUsage(voucher, userId, bookingId)
  BookingService-->>Controller: BookingResponse
  Controller-->>FE: ApiResponse<BookingResponse>

  alt VIETQR payment
    Client->>FE: Submit payment transferred
    FE->>Controller: PATCH /api/user/bookings/{id}/payment-submitted
    Controller->>BookingService: markPaymentSubmitted(bookingId, userId)
    BookingService->>DB: Set payment status PENDING
  end
