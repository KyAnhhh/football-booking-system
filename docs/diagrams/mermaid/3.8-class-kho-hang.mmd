classDiagram
  direction TB

  class InventoryItem {
    +id
    +maHang
    +tenHang
    +loaiHang
    +hanhViKho
  }

  class InventoryStock {
    +id
    +tonThucTe
    +tonGiuCho
    +tonKhaDung
    +giaVonTrungBinh
  }

  class InventoryTransaction {
    +id
    +loaiGiaoDich
    +soLuong
    +loaiThamChieu
    +maThamChieu
  }

  class InventoryReservation {
    +id
    +loaiThamChieu
    +maThamChieu
    +soLuong
    +trangThai
  }

  class Supplier {
    +id
    +tenNhaCungCap
    +soDienThoai
    +dangHoatDong
  }

  class StockImport {
    +id
    +maPhieuNhap
    +tongTien
    +trangThai
  }

  class StockImportItem {
    +id
    +soLuong
    +donGiaNhap
    +thanhTien
  }

  class ProductVariant {
    +id
    +giaBan
    +tonKho
  }

  class ExtraService {
    +id
    +tenDichVu
    +gia
    +coTheoDoiKho
  }

  ProductVariant "0..1" --> "1" InventoryItem : liên kết tồn kho
  ExtraService "0..1" --> "1" InventoryItem : liên kết tồn kho
  InventoryItem "1" --> "1" InventoryStock : có tồn kho
  InventoryItem "1" --> "n" InventoryTransaction : phát sinh giao dịch
  InventoryItem "1" --> "n" InventoryReservation : giữ chỗ
  Supplier "1" --> "n" StockImport : cung cấp
  StockImport "1" --> "n" StockImportItem : gồm dòng nhập
  StockImportItem "n" --> "1" InventoryItem : nhập hàng
