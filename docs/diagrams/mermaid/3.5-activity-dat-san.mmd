flowchart TD
  BatDau([Bắt đầu]) --> ChonSan["Khách hàng chọn sân bóng"]
  ChonSan --> ChonSlot["Chọn ngày và khung giờ còn trống"]
  ChonSlot --> ChonDichVu["Chọn dịch vụ bổ sung"]
  ChonDichVu --> GiamThanhVien["Áp dụng ưu đãi thành viên"]
  GiamThanhVien --> CoVoucher{"Có mã voucher?"}
  CoVoucher -- Có --> KiemVoucher["Kiểm tra và áp dụng voucher"]
  CoVoucher -- Không --> TaoBooking["Tạo booking"]
  KiemVoucher --> TaoBooking
  TaoBooking --> TaoPayment["Tạo payment trạng thái UNPAID"]
  TaoPayment --> GiuTon["Giữ chỗ tồn kho dịch vụ nếu có"]
  GiuTon --> VietQR{"Thanh toán VietQR?"}
  VietQR -- Có --> KhachBao["Khách báo đã chuyển khoản"]
  KhachBao --> ChoXacNhan["Payment = PENDING"]
  ChoXacNhan --> AdminXacNhan{"Admin xác nhận tiền?"}
  AdminXacNhan -- Có --> DaTra["Payment = PAID"]
  DaTra --> XacNhan["Booking = CONFIRMED"]
  AdminXacNhan -- Không --> HuyHetHan["Hủy hoặc hết hạn booking"]
  HuyHetHan --> HoanTaiNguyen["Giải phóng tồn kho và voucher"]
  HoanTaiNguyen --> KetThucHuy([Kết thúc])
  VietQR -- Không --> XacNhan
  XacNhan --> Checkin["Nhân viên check-in"]
  Checkin --> DangDa["Booking = IN_PROGRESS"]
  DangDa --> Checkout["Nhân viên check-out"]
  Checkout --> HoanTat["Booking = COMPLETED"]
  HoanTat --> CongDiem["Cộng điểm thành viên"]
  CongDiem --> TraDichVuThue["Hoàn lại dịch vụ cho thuê nếu có"]
  TraDichVuThue --> KetThuc([Kết thúc])
