flowchart TD
  Start([Start]) --> SelectField["Client selects football field"]
  SelectField --> SelectSlot["Choose date and available slot"]
  SelectSlot --> SelectExtra["Select extra services"]
  SelectExtra --> Membership["Apply membership discount"]
  Membership --> HasVoucher{"Voucher code?"}
  HasVoucher -- Yes --> ConsumeVoucher["Validate and consume voucher"]
  HasVoucher -- No --> CreateBooking["Create booking"]
  ConsumeVoucher --> CreateBooking
  CreateBooking --> CreatePayment["Create payment with UNPAID status"]
  CreatePayment --> ReserveStock["Reserve extra service stock if tracked"]
  ReserveStock --> IsVietQR{"Payment method is VietQR?"}
  IsVietQR -- Yes --> SubmitPay["Client submits payment transferred"]
  SubmitPay --> Pending["Payment status = PENDING"]
  Pending --> AdminConfirm{"Admin confirms payment?"}
  AdminConfirm -- Yes --> Paid["Payment status = PAID"]
  Paid --> Confirmed["Booking status = CONFIRMED"]
  AdminConfirm -- No --> CancelExpire["Cancel or expire booking"]
  CancelExpire --> Release["Release stock and voucher usage"]
  Release --> RefundReview["Create refund review if payment was pending"]
  RefundReview --> EndCancel([End])
  IsVietQR -- No --> Confirmed
  Confirmed --> Checkin["Staff/Admin check-in"]
  Checkin --> InProgress["Booking status = IN_PROGRESS"]
  InProgress --> Checkout["Staff/Admin check-out"]
  Checkout --> Completed["Booking status = COMPLETED"]
  Completed --> Points["Add membership loyalty points"]
  Points --> ReturnRental["Return rental extra services if needed"]
  ReturnRental --> End([End])
