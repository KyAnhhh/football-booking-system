  PAYMENTS {
    bigint id PK
    varchar payment_type
    varchar payment_method
    varchar payment_status
    decimal total_amount
    varchar transaction_code
  }
  REFUND_REQUESTS {
    bigint id PK
    bigint payment_id FK
    varchar refund_status
    varchar bank_account
    decimal refund_amount
  }
  INVENTORY_ITEMS {
    bigint id PK
    varchar item_code
    varchar name
    varchar item_type
    varchar inventory_behavior
  }
  INVENTORY_STOCKS {
    bigint id PK
    bigint item_id FK
    int quantity_on_hand
    int reserved_quantity
    int available_quantity
    decimal average_unit_cost
  }
  STOCK_IMPORTS {
    bigint id PK
    bigint supplier_id FK
    varchar import_code
    varchar status
    decimal total_amount
  }
