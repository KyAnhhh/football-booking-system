erDiagram
  %% A4-friendly ERD: catalog, cart, order, wishlist, product review.

  CATEGORY ||--o{ PRODUCT : groups
  BRAND ||--o{ PRODUCT : owns
  PRODUCT ||--o{ PRODUCT_VARIANT : has
  PRODUCT ||--o{ PRODUCT_IMAGE : has
  SIZE ||--o{ PRODUCT_VARIANT : sizes
  PRODUCT_VARIANT ||--o{ CART_ITEM : selected
  PRODUCT_VARIANT ||--o{ ORDER_ITEM : sold
  USER ||--|| CART : owns
  CART ||--o{ CART_ITEM : contains
  USER ||--o{ ORDERS : places
  SHIPPING_ADDRESS ||--o{ ORDERS : ships_to
  ORDERS ||--o{ ORDER_ITEM : contains
  USER ||--o{ WISHLIST_ITEM : saves
  PRODUCT ||--o{ WISHLIST_ITEM : saved
  USER ||--o{ REVIEW : writes
  PRODUCT ||--o{ REVIEW : receives
  ORDER_ITEM ||--o{ REVIEW : verifies

  USER {
    BIGINT id PK
    STRING username
    STRING email
    STRING role
    STRING status
  }

  SHIPPING_ADDRESS {
    BIGINT id PK
    STRING fullName
    STRING phone
    STRING city
    STRING district
  }

  CATEGORY {
    BIGINT id PK
    STRING name
    STRING description
    DATETIME createdAt
    DATETIME updatedAt
  }

  BRAND {
    BIGINT id PK
    STRING name
    STRING description
    STRING logoUrl
    DATETIME createdAt
    DATETIME updatedAt
  }

  PRODUCT {
    BIGINT id PK
    STRING name
    STRING description
    INT discount
    STRING publicationStatus
    DATETIME createdAt
    DATETIME updatedAt
  }

  SIZE {
    BIGINT id PK
    STRING code
    STRING name
    STRING description
  }

  PRODUCT_VARIANT {
    BIGINT id PK
    DECIMAL price
    INT stock
    INT soldQuantity
    BIGINT inventoryItemId
  }

  PRODUCT_IMAGE {
    BIGINT id PK
    STRING imageUrl
    BOOLEAN isPrimary
    INT sortOrder
  }

  CART {
    BIGINT id PK
    DECIMAL totalAmount
    DATETIME createdAt
    DATETIME updatedAt
  }

  CART_ITEM {
    BIGINT id PK
    STRING productName
    STRING sizeCode
    INT totalQuantity
    DECIMAL priceAtAddedTime
  }

  ORDERS {
    BIGINT id PK
    DECIMAL totalAmount
    STRING orderStatus
    STRING paymentMethod
    DECIMAL shippingCost
    DATETIME orderDate
    DATETIME deliveryDate
  }

  ORDER_ITEM {
    BIGINT id PK
    STRING productName
    STRING sizeName
    INT quantity
    DECIMAL unitPrice
    DECIMAL finalPrice
    DECIMAL total
    BOOLEAN stockDeducted
    BOOLEAN stockReserved
    BOOLEAN stockReturned
  }

  WISHLIST_ITEM {
    BIGINT id PK
    DATETIME createdAt
  }

  REVIEW {
    BIGINT id PK
    INT rating
    STRING comment
    DATETIME createdAt
    DATETIME updatedAt
  }
