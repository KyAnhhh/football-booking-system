flowchart TD
  BatDau([Bắt đầu]) --> ChonNCC["Chọn nhà cung cấp"]
  ChonNCC --> TaoPhieu["Tạo phiếu nhập kho"]
  TaoPhieu --> Draft["Trạng thái phiếu = DRAFT"]
  Draft --> ThemDong["Thêm dòng hàng nhập"]
  ThemDong --> NhapThongTin["Nhập mặt hàng, số lượng, đơn giá"]
  NhapThongTin --> KiemTra{"Dữ liệu hợp lệ?"}

  KiemTra -- Không --> BaoLoi["Thông báo lỗi nhập liệu"]
  BaoLoi --> NhapThongTin

  KiemTra -- Có --> LuuDong["Lưu dòng phiếu nhập"]
  LuuDong --> ConHang{"Còn mặt hàng cần nhập?"}
  ConHang -- Có --> ThemDong
  ConHang -- Không --> XemLai["Kiểm tra lại phiếu nhập"]

  XemLai --> QuyếtDinh{"Thao tác với phiếu?"}
  QuyếtDinh -- "Ghi sổ" --> KiemTon["Kiểm tra tồn kho hiện tại"]
  QuyếtDinh -- "Hủy phiếu" --> HuyPhieu["Cập nhật phiếu = CANCELLED"]
  QuyếtDinh -- "Lưu nháp" --> GiuDraft["Giữ phiếu ở trạng thái DRAFT"]

  KiemTon --> CapNhatTon["Tăng số lượng tồn thực tế"]
  CapNhatTon --> GiaVon["Cập nhật giá vốn trung bình"]
  GiaVon --> GiaoDich["Ghi lịch sử giao dịch kho"]
  GiaoDich --> DongBo["Đồng bộ tồn kho sản phẩm/dịch vụ"]
  DongBo --> Posted["Cập nhật phiếu = POSTED"]

  Posted --> KetThuc([Kết thúc])
  HuyPhieu --> KetThuc
  GiuDraft --> KetThuc

