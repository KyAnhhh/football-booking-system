flowchart TD
  BatDau([Bắt đầu]) --> ChonLoai["Admin chọn loại dữ liệu import"]
  ChonLoai --> TaiMau["Tải file mẫu CSV"]
  TaiMau --> NhapDuLieu["Điền dữ liệu vào file CSV"]
  NhapDuLieu --> Upload["Upload file CSV"]
  Upload --> DocFile["Backend đọc file CSV"]
  DocFile --> KiemDong["Kiểm tra từng dòng dữ liệu"]
  KiemDong --> HopLe{"Dòng dữ liệu hợp lệ?"}
  HopLe -- Có --> AnhXa["Chuyển dòng CSV thành entity"]
  AnhXa --> LuuDB["Lưu vào cơ sở dữ liệu"]
  HopLe -- Không --> GhiLoi["Ghi nhận lỗi theo dòng"]
  LuuDB --> ConDong{"Còn dòng tiếp theo?"}
  GhiLoi --> ConDong
  ConDong -- Có --> KiemDong
  ConDong -- Không --> TongHop["Tổng hợp số dòng thành công và lỗi"]
  TongHop --> TraKetQua["Trả ImportResultResponse"]
  TraKetQua --> KetThuc([Kết thúc])
