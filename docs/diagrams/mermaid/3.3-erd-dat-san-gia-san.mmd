  FOOTBALL_FIELDS {
    bigint id PK
    varchar name
    varchar field_type
    varchar status
    decimal price_per_hour
  }
  BOOKINGS {
    bigint id PK
    bigint user_id FK
    bigint field_id FK
    datetime start_time
    datetime end_time
    decimal total_price
    varchar status
  }
  FIELD_PRICING_RULES {
    bigint id PK
    bigint field_id FK
    varchar day_of_week
    time start_time
    time end_time
    decimal slot_price
  }
  MAINTENANCES {
    bigint id PK
    bigint field_id FK
    datetime start_time
    datetime end_time
    varchar reason
  }
