sequenceDiagram
  autonumber
  actor Client
  participant FE as React Checkout Page
  participant Controller as UserOrderController
  participant OrderService as OrderServiceImpl
  participant DB as MySQL
  participant Inventory as InventoryService
  participant Payment as Payment Entity
  participant Notify as NotificationService

  Client->>FE: Confirm checkout
  FE->>Controller: POST /api/user/orders/checkout-cart
  Controller->>OrderService: checkout(userId, request)
  OrderService->>DB: Load user, cart, shipping address
  OrderService->>OrderService: Validate payment method COD/VIETQR
  OrderService->>DB: Build Order and OrderItems
  OrderService->>Payment: Create payment status UNPAID
  OrderService->>DB: Save order with payment

  loop Each order item with inventory mapping
    OrderService->>Inventory: reserveStock(itemId, qty, ORDER)
    Inventory->>DB: Create reservation and update stock
  end

  OrderService->>DB: Save reservation info and clear cart
  OrderService->>Notify: Notify order created
  OrderService-->>Controller: OrderResponse
  Controller-->>FE: ApiResponse<OrderResponse>

  alt VIETQR payment
    Client->>FE: Open order payment page
    FE->>Controller: PUT /api/user/orders/{id}/payment-submitted
    Controller->>OrderService: markPaymentSubmitted(orderId, userId)
    OrderService->>DB: Set payment status PENDING
    OrderService->>Notify: Notify admin payment submitted
  else COD payment
    Note over Client,Payment: Payment remains UNPAID until delivery
  end
