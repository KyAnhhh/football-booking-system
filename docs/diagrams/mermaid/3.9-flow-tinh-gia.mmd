flowchart TD
  BatDau([Bắt đầu]) --> DauVao["Nhận thông tin tính giá\nsân/ngày/slot/dịch vụ/voucher"]
  DauVao --> KiemTra["Kiểm tra sân, thời gian và số lượng"]
  KiemTra --> NgayLe{"Có quy tắc giá ngày lễ?"}
  NgayLe -- Có --> GiaNgayLe["Áp dụng giá ngày lễ"]
  NgayLe -- Không --> GiaThuong["Áp dụng giá theo thứ và khung giờ"]
  GiaNgayLe --> TienSan["Tính tiền thuê sân"]
  GiaThuong --> TienSan
  TienSan --> CoDichVu{"Có dịch vụ bổ sung?"}
  CoDichVu -- Có --> TienDichVu["Tính tiền dịch vụ bổ sung"]
  CoDichVu -- Không --> TamTinh["Tổng tạm tính"]
  TienDichVu --> TamTinh
  TamTinh --> ThanhVien{"Người dùng có hạng thành viên?"}
  ThanhVien -- Có --> GiamThanhVien["Áp dụng giảm giá thành viên"]
  ThanhVien -- Không --> CoVoucher{"Có mã voucher?"}
  GiamThanhVien --> CoVoucher
  CoVoucher -- Có --> KiemVoucher["Kiểm tra điều kiện voucher"]
  KiemVoucher --> GiamVoucher["Áp dụng giảm giá voucher"]
  CoVoucher -- Không --> TongTien["Tính tổng tiền cuối cùng"]
  GiamVoucher --> TongTien
  TongTien --> TraKetQua["Trả kết quả tính giá"]
  TraKetQua --> KetThuc([Kết thúc])
