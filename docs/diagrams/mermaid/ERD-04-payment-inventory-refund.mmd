erDiagram
  %% A4-friendly ERD: payment, refund, inventory, supplier, stock import.

  USER ||--o{ REFUND_REQUEST : requests
  USER ||--o{ REFUND_REQUEST : processes
  PAYMENT ||--o{ REFUND_REQUEST : refunded_by
  PAYMENT ||--o| ORDERS : pays_order
  PAYMENT ||--o| BOOKING : pays_booking
  INVENTORY_ITEM ||--|| INVENTORY_STOCK : has
  INVENTORY_ITEM ||--o{ INVENTORY_TRANSACTION : moves
  INVENTORY_ITEM ||--o{ INVENTORY_RESERVATION : reserves
  USER ||--o{ INVENTORY_TRANSACTION : creates
  USER ||--o{ INVENTORY_RESERVATION : creates
  SUPPLIER ||--o{ STOCK_IMPORT : supplies
  USER ||--o{ STOCK_IMPORT : creates
  STOCK_IMPORT ||--o{ STOCK_IMPORT_ITEM : contains
  INVENTORY_ITEM ||--o{ STOCK_IMPORT_ITEM : imported
  PRODUCT_VARIANT ||..o| INVENTORY_ITEM : linked_by_inventoryItemId
  EXTRA_SERVICE ||..o| INVENTORY_ITEM : linked_by_inventoryItemId
  ORDER_ITEM ||..o| INVENTORY_RESERVATION : reserves_by_id
  BOOKING_EXTRA_SERVICE ||..o| INVENTORY_RESERVATION : reserves_by_id

  USER {
    BIGINT id PK
    STRING username
    STRING email
    STRING role
  }

  PAYMENT {
    BIGINT id PK
    STRING paymentType
    STRING paymentStatus
    DECIMAL totalAmount
    STRING paymentMethod
    STRING transactionCode
    DATETIME paymentDate
    DATETIME createdAt
    DATETIME updatedAt
  }

  ORDERS {
    BIGINT id PK
    DECIMAL totalAmount
    STRING orderStatus
    STRING paymentMethod
  }

  BOOKING {
    BIGINT id PK
    DECIMAL totalPrice
    STRING status
    DATETIME startTime
    DATETIME endTime
  }

  REFUND_REQUEST {
    BIGINT id PK
    BIGINT orderId
    BIGINT bookingId
    DECIMAL amount
    STRING reason
    STRING status
    STRING bankCode
    STRING bankAccountNumber
    STRING bankAccountName
    STRING refundTransactionCode
    DATETIME requestedAt
    DATETIME processedAt
  }

  INVENTORY_ITEM {
    BIGINT id PK
    STRING itemCode
    STRING name
    STRING itemType
    STRING inventoryBehavior
    BIGINT referenceId
    STRING unit
    BOOLEAN active
    INT lowStockThreshold
  }

  INVENTORY_STOCK {
    BIGINT id PK
    INT quantityOnHand
    INT reservedQuantity
    INT availableQuantity
    DECIMAL averageUnitCost
    DECIMAL inventoryValue
    DATETIME updatedAt
  }

  INVENTORY_TRANSACTION {
    BIGINT id PK
    STRING transactionType
    INT quantity
    INT beforeQuantity
    INT afterQuantity
    STRING referenceType
    BIGINT referenceId
    STRING note
    DATETIME createdAt
  }

  INVENTORY_RESERVATION {
    BIGINT id PK
    STRING referenceType
    BIGINT referenceId
    BIGINT referenceLineId
    INT quantity
    STRING status
    DATETIME reservedAt
    DATETIME expiresAt
    DATETIME committedAt
    DATETIME releasedAt
  }

  SUPPLIER {
    BIGINT id PK
    STRING name
    STRING phone
    STRING email
    STRING address
    BOOLEAN active
  }

  STOCK_IMPORT {
    BIGINT id PK
    STRING importCode
    DECIMAL totalAmount
    STRING status
    STRING note
    DATETIME createdAt
    DATETIME postedAt
    DATETIME cancelledAt
  }

  STOCK_IMPORT_ITEM {
    BIGINT id PK
    INT quantity
    DECIMAL unitCost
    DECIMAL totalCost
  }

  PRODUCT_VARIANT {
    BIGINT id PK
    DECIMAL price
    INT stock
    BIGINT inventoryItemId
  }

  EXTRA_SERVICE {
    BIGINT id PK
    STRING name
    DECIMAL price
    BIGINT inventoryItemId
  }

  ORDER_ITEM {
    BIGINT id PK
    INT quantity
    BIGINT inventoryReservationId
  }

  BOOKING_EXTRA_SERVICE {
    BIGINT id PK
    INT quantity
    BIGINT inventoryReservationId
  }
