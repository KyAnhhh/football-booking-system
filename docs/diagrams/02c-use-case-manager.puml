@startuml
title Use Case Diagram - Quản lý

left to right direction
skinparam shadowing false

actor "Quản lý\nROLE_MANAGER" as MANAGER

rectangle "Admin Management" {
  usecase "Đăng nhập admin" as UC_LOGIN
  usecase "Xem dashboard" as UC_DASHBOARD
  usecase "Xem lịch sân" as UC_CALENDAR

  usecase "Quản lý booking" as UC_BOOKING
  usecase "Tạo booking hộ khách" as UC_ADMIN_BOOKING
  usecase "Xác nhận booking" as UC_CONFIRM
  usecase "Check-in / Check-out" as UC_CHECK
  usecase "Quản lý đơn hàng" as UC_ORDER
  usecase "Quản lý thanh toán" as UC_PAYMENT

  usecase "Quản lý sân bóng" as UC_FIELD
  usecase "Quản lý bảng giá theo thứ" as UC_PRICING
  usecase "Quản lý giá ngày lễ" as UC_HOLIDAY_PRICING
  usecase "Quản lý ngày lễ" as UC_HOLIDAY
  usecase "Quản lý bảo trì" as UC_MAINTENANCE
  usecase "Quản lý voucher" as UC_VOUCHER
  usecase "Quản lý dịch vụ thêm" as UC_EXTRA

  usecase "Quản lý sản phẩm" as UC_PRODUCT
  usecase "Quản lý thương hiệu" as UC_BRAND
  usecase "Quản lý danh mục" as UC_CATEGORY
  usecase "Quản lý kích cỡ" as UC_SIZE
  usecase "Import dữ liệu" as UC_IMPORT
  usecase "Xem thông báo" as UC_NOTIFICATION
}

MANAGER --> UC_LOGIN
MANAGER --> UC_DASHBOARD
MANAGER --> UC_CALENDAR

MANAGER --> UC_BOOKING
MANAGER --> UC_ADMIN_BOOKING
MANAGER --> UC_CONFIRM
MANAGER --> UC_CHECK
MANAGER --> UC_ORDER
MANAGER --> UC_PAYMENT

MANAGER --> UC_FIELD
MANAGER --> UC_PRICING
MANAGER --> UC_HOLIDAY_PRICING
MANAGER --> UC_HOLIDAY
MANAGER --> UC_MAINTENANCE
MANAGER --> UC_VOUCHER
MANAGER --> UC_EXTRA

MANAGER --> UC_PRODUCT
MANAGER --> UC_BRAND
MANAGER --> UC_CATEGORY
MANAGER --> UC_SIZE
MANAGER --> UC_IMPORT
MANAGER --> UC_NOTIFICATION

UC_ADMIN_BOOKING .> UC_BOOKING : <<extend>>
UC_CONFIRM .> UC_BOOKING : <<extend>>
UC_CHECK .> UC_BOOKING : <<extend>>
UC_HOLIDAY_PRICING .> UC_HOLIDAY : <<include>>
UC_HOLIDAY_PRICING .> UC_FIELD : <<include>>

legend bottom
  Manager tập trung vào vận hành và dữ liệu kinh doanh.
  Không bao gồm quản lý user/role và membership tier theo SecurityConfiguration hiện tại.
endlegend

@enduml
