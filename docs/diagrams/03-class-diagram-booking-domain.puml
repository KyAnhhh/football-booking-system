@startuml
title Class Diagram - Booking Domain

skinparam classAttributeIconSize 0
skinparam shadowing false
hide methods

class User {
  Long id
  String username
  String email
  String phone
  Role role
  Integer loyaltyPoints
}

class FootballField {
  Long id
  String name
  FieldType type
  BigDecimal pricePerHour
  FieldStatus status
  String address
}

class Maintenance {
  Long id
  Long fieldId
  LocalDateTime startTime
  LocalDateTime endTime
  String reason
  String description
  LocalDateTime createdAt
  LocalDateTime updatedAt
}

class Booking {
  Long id
  LocalDateTime startTime
  LocalDateTime endTime
  BigDecimal originalPrice
  BigDecimal extraServicePrice
  BigDecimal membershipDiscount
  BigDecimal voucherDiscount
  String voucherCode
  BigDecimal totalPrice
  BookingStatus status
  String contactPhone
  String note
  LocalDateTime createdAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

class Payment {
  Long id
  PaymentType paymentType
  PaymentStatus paymentStatus
  BigDecimal totalAmount
  PaymentMethod paymentMethod
  String transactionCode
  LocalDateTime paymentDate
}

class ExtraService {
  Long id
  String name
  BigDecimal price
  Boolean isActive
  Boolean trackStock
  Integer stockQuantity
  Integer remainingQuantity
  String unit
  Long inventoryItemId
}

class Voucher {
  Long id
  String code
  String description
  DiscountType discountType
  BigDecimal discountValue
  Integer quantity
  Boolean isActive
  LocalDateTime startDate
  LocalDateTime endDate
}

class BookingExtraService {
  Long id
  Integer quantity
  BigDecimal unitPrice
  BigDecimal totalPrice
  Boolean stockDeducted
  Boolean stockReserved
  Boolean stockReturned
  Long inventoryReservationId
  Long inventoryTransactionId
}

class VoucherUsage {
  Long id
  Long voucherId
  Long bookingId
  Long userId
  String voucherCode
  BigDecimal discountAmount
  Boolean isRefunded
  LocalDateTime usedAt
  LocalDateTime refundedAt
}

class InventoryItem {
  Long id
  String itemCode
  InventoryItemType itemType
}

class InventoryStock {
  Long id
  Integer quantityOnHand
  Integer reservedQuantity
  Integer availableQuantity
}

class InventoryTransaction {
  Long id
  InventoryTransactionType transactionType
  Integer quantity
  Integer beforeQuantity
  Integer afterQuantity
  InventoryReferenceType referenceType
  Long referenceId
}

class InventoryReservation {
  Long id
  Integer quantity
  InventoryReservationStatus status
}

class BookingReview {
  Long id
}

class BookingStatusHistory {
  Long id
  BookingStatus oldStatus
  BookingStatus newStatus
  String changedByName
  String changedByRole
  String note
  LocalDateTime createdAt
}

User "1" -- "0..*" Booking : tạo
FootballField "1" -- "0..*" Booking : được đặt
FootballField "1" -- "0..*" Maintenance : lịch bảo trì
Booking "1" -- "1" Payment : payment
Booking "1" -- "0..*" BookingExtraService : dịch vụ thêm
ExtraService "1" -- "0..*" BookingExtraService : được chọn
Booking "1" -- "0..1" BookingReview : đánh giá
Booking "1" -- "0..*" BookingStatusHistory : lịch sử trạng thái
User "0..1" -- "0..*" BookingStatusHistory : người đổi trạng thái
Voucher "1" -- "0..*" VoucherUsage : sử dụng
Booking "1" -- "0..1" VoucherUsage : voucher trong booking
User "1" -- "0..*" VoucherUsage : người dùng voucher

Booking --> BookingStatus
ExtraService "0..*" ..> "0..1" InventoryItem : inventoryItemId
InventoryItem "1" -- "1" InventoryStock : current stock
InventoryItem "1" -- "0..*" InventoryTransaction : stock history
BookingExtraService "0..*" ..> "0..1" InventoryTransaction : inventoryTransactionId
BookingExtraService "0..*" ..> "0..1" InventoryReservation : inventoryReservationId
InventoryItem "1" -- "0..*" InventoryReservation : reservations

note right of VoucherUsage
  Source hiện vẫn giữ voucherId, bookingId, userId
  để phục vụ service hiện tại.
  Đồng thời đã có @ManyToOne read-only:
  voucher, booking, user.
end note

note right of Maintenance
  Source hiện vẫn giữ fieldId
  và đã thêm @ManyToOne read-only tới FootballField.
end note

note bottom of Booking
  Booking có breakdown giá:
  originalPrice, extraServicePrice,
  membershipDiscount, voucherDiscount,
  totalPrice.
end note

note bottom of BookingExtraService
  Khi tạo booking, extra có inventoryItemId sẽ trừ tồn bằng khóa bi quan
  và lưu inventoryTransactionId. Khi CANCELLED hoặc EXPIRED,
  stockDeducted/stockReturned bảo đảm hoàn tồn đúng một lần.
end note

@enduml
