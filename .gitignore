# ========================
# Backend (Spring Boot)
# ========================
back-end/target/
back-end/.idea/
back-end/.vscode/
back-end/*.iml
back-end/*.iws
back-end/*.ipr

# Maven Wrapper (ignore jar)
back-end/.mvn/wrapper/maven-wrapper.jar

# Spring Boot - ignore local environment configs
back-end/*.env
back-end/src/main/resources/application-*.properties

# Uploads (if storing images locally)
back-end/uploads/
back-end/src/main/resources/static/uploads/


# ========================
# Frontend (React)
# ========================
front-end/node_modules/
front-end/build/
front-end/dist/
front-end/.next/

# Environment variables
front-end/.env
front-end/.env.local
front-end/.env.development
front-end/.env.production

# Lock files (optional – remove if team uses same package manager)
# front-end/yarn.lock
# front-end/package-lock.json

# Uploads in frontend (if any)
front-end/public/uploads/


# ========================
# System files
# ========================
.DS_Store
Thumbs.db
*.tmp
*.cache


# ========================
# Logs
# ========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ========================
# Editor / OS
# ========================
.vscode/
.idea/
*.swp
